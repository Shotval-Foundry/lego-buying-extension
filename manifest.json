{
  "manifest_version": 3,
  "name": "Lego Buying Foundry Helper",
  "version": "1.0.0",
  "description": "協助收集 Ruten 樂高零件報價並送出計算",
  "permissions": [],
  "host_permissions": [
    "https://rtapi.ruten.com.tw/*",
    "https://lego-buying-backend.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:5500/*",
        "http://localhost:5500/*",
        "https://lego-buying-tool.netlify.app/*"
      ],
      "js": ["content-script.js"]
    }
  ]
}